<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Enforce HTTPS by default for all external traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Permit cleartext HTTP specifically for local development server, emulators, and confirmed CDNs -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.31.110</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">aoneroom.com</domain>
        <domain includeSubdomains="true">hakunaymatata.com</domain>
    </domain-config>
</network-security-config>

